// Material: __MATERIAL_NAME__
// Auto-generated by UnifiedMaterial::generate_gbuffer_source().
// This template stays valid Slang with the default expressions below.

// Vertex data
struct InstanceData { float4x4 model; };
StructuredBuffer<InstanceData> instances;

struct CameraConstants {
    float4x4 view_proj;
    float4x4 previous_view_proj;
    float time;
    float3 _pad;
};
uniform CameraConstants cam;

struct VSOut {
    float4 position : SV_POSITION;
    float3 normal : NORMAL;
    float2 uv : TEXCOORD0;
    float3 world_pos : TEXCOORD1;
    float4 tangent : TANGENT;
};

// Texture and sampler bindings
/*__MATERIAL_DECLS__*/

// Octahedral normal encoding
float2 oct_encode(float3 n) {
    float3 a = abs(n);
    n /= a.x + a.y + a.z;
    if (n.z < 0.0) {
        float2 s = float2(n.x >= 0.0 ? 1.0 : -1.0,
                          n.y >= 0.0 ? 1.0 : -1.0);
        n.xy = (1.0 - abs(n.yx)) * s;
    }
    return n.xy;
}

// G-Buffer output
// G3 removed; world position is reconstructed from depth in deferred_lighting.slang.
struct GBufferOut {
    float4 g0 : SV_TARGET0; // base_color.rgb | metallic
    float4 g1 : SV_TARGET1; // oct-normal.xy | roughness | 0
    float4 g2 : SV_TARGET2; // emissive.rgb | 0
};

// Material evaluation
GBufferOut main(VSOut v) {
    float4 base_color = float4(1.0, 1.0, 1.0, 1.0); // __MATERIAL_BASE_COLOR__
    float metallic = 0.0; // __MATERIAL_METALLIC__
    float roughness = 1.0; // __MATERIAL_ROUGHNESS__
    float3 normal_ts = float3(0.0, 0.0, 1.0); // __MATERIAL_NORMAL__
    float3 emissive = float3(0.0, 0.0, 0.0); // __MATERIAL_EMISSIVE__

    float3 N = normalize(v.normal);
    float3 T = normalize(v.tangent.xyz);
    T = normalize(T - N * dot(N, T));
    float3 B = cross(N, T) * v.tangent.w;
    float3x3 tbn = float3x3(T, B, N);
    N = normalize(mul(normal_ts, tbn));
    float2 oct_n = oct_encode(N);

    GBufferOut o;
    o.g0 = float4(base_color.rgb, metallic);
    o.g1 = float4(oct_n, roughness, 0.0);
    o.g2 = float4(emissive, 0.0);
    return o;
}
